    "restore-drill": "tsx src/restoreDrill.ts"
  },
  "dependencies": {
    "@phoneup/core": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.5",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1"
  }
