# PhoneUp Round-Robin — environment
# Copy to .env for local work. In production these are set on the platform (Railway
# variables), not from a file.

# ---- required ----

# Postgres connection. There is NO fallback: the API refuses to start without this, and
# drizzle-kit refuses to migrate, so a misconfigured deploy fails loudly instead of
# quietly serving an empty local database.
DATABASE_URL=postgresql://localhost/phoneup_dev

# ---- optional ----

# HTTP port the API listens on. Railway sets this itself.
# PORT=3000

# Allowed browser origin for CORS. Normally unset: production serves apps/web/dist from the
# API's own origin, and development proxies /trpc and /ws/board through Vite (see
# apps/web/vite.config.ts), so both are same-origin. Only needed if you deliberately run the
# browser app on a different origin — note that the board WebSocket will still be rejected
# there, because the sameSite=lax session cookie is not sent on a cross-site handshake.
# WEB_ORIGIN=http://localhost:5173

# Set by `pnpm --filter @phoneup/api start`. Drives secure session cookies and blocks the
# dev seed script. Do not set it to production locally.
# NODE_ENV=production

# First ADMIN account created by `pnpm --filter @phoneup/db import-roster`.
# Defaults to the maintainer's address; override to bootstrap a different deployment.
# ADMIN_EMAIL=you@example.com

# ---- test ----

# Test database. Defaults to postgresql://localhost/phoneup_test. Deliberately a separate
# variable from DATABASE_URL so an exported production connection can never point the
# destructive test suite at a real database; the suite also refuses any database whose name
# does not contain "test". CI sets this because its Postgres service needs credentials.
# TEST_DATABASE_URL=postgresql://localhost/phoneup_test
