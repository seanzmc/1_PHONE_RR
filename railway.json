{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @phoneup/web build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @phoneup/db migrate && pnpm --filter @phoneup/api start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
